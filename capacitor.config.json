{
  "appId": "org.dhoomvivekanandasamiti.app",
  "appName": "Dhoom Vivekananda Samiti",
  "webDir": "dist",
  "backgroundColor": "#54121a",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 400,
      "backgroundColor": "#54121a",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    }
  }
}
