# Supabase (already in your .env)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Donation payment details shown on the "Donate Online" form.
# Leave a line empty to hide it. Use only OFFICIAL numbers approved by the temple committee.
VITE_DONATION_BKASH=
VITE_DONATION_NAGAD=
VITE_DONATION_ROCKET=
VITE_DONATION_BANK=
# Card payments: paste a Stripe / SSLCommerz "Payment Link" here to show a "Pay by card" button.
VITE_DONATION_PAYMENT_URL=

# Public website address (used by the Share button, also inside the phone app), e.g. https://dhoomvivekanandasamiti.org
VITE_SITE_URL=
